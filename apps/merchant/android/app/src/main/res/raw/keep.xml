<?xml version="1.0" encoding="utf-8"?>
<!--
  These resources are referenced only by name from Dart
  (RawResourceAndroidNotificationSound and the notification icon), so the
  release resource shrinker cannot see the references and removes them. Keep
  them in release builds; a missing raw resource makes NotificationManager
  show() fail and the notification never appears.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@raw/krapow_mallet,@raw/service_bell,@raw/light_chime,@drawable/ic_order_notification" />

